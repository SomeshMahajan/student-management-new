pipeline {
    agent {
        label "worker"
    }
    environment {
        my_aws_credentials = credentials('aws-access')
    }

    tools{
        maven "maven"
    }
    stages {
        stage("checkout") {
            steps{
                git branch: 'main', url: 'https://github.com/SomeshMahajan/student-management-new.git'
                sh '''
                echo 'clonning is successful'
                '''
            }
        }

        stage('build'){
            steps{
                sh '''
                mvn clean package
                echo 'build is successful'
                '''
            }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }
        
        stage('Artifact to s3'){
            steps {
                sh '''
                aws s3 cp target/*.war s3://stairs-to-cloud.space/Artifact/student.war
                '''
            }
        }
        
        stage('SonarQube Analysis'){
            steps {
                withSonarQubeEnv('sonar') {
                    sh 'mvn sonar:sonar'
                }
            }
        }
        
        stage('SonarQube Quality Gates'){
            steps {
                timeout(time:5, unit: 'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        
        stage('Docker Build') {
            steps {
                sh '''
                docker build --no-cache -t studentapp:latest .
                docker images
                '''
            }
        }

        stage('push image to ECR') {
            steps {
                sh '''
                aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 800380166958.dkr.ecr.ap-south-1.amazonaws.com/student
                docker tag studentapp:latest 800380166958.dkr.ecr.ap-south-1.amazonaws.com/student:latest
                docker push 800380166958.dkr.ecr.ap-south-1.amazonaws.com/student:latest
                '''
            }
        }

        stage('Deploy to EKS') {
            steps {
                sh '''
                aws eks update-kubeconfig --region ap-south-1 --name my-cluster-eks
                sudo snap install kubectl --classic
                kubectl apply -f k8s/
                kubectl get pods
                sleep 10
                kubectl get pods
                kubectl get svc -o wide 
                '''
            }
        }
    }
}

